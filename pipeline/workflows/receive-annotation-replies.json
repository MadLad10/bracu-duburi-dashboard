{
  "name": "AUV - Receive Annotation Replies",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {
          "hasAttachment": true
        },
        "options": {
          "downloadAttachments": true
        }
      },
      "id": "gmail-trigger",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1,
      "position": [
        -760,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Gmail attachments arrive as BINARY properties (attachment_0, ...) when the\n// trigger has downloadAttachments enabled — not as json.attachments[].content.\nconst item = $input.first();\nconst bin  = item.binary || {};\nconst key  = Object.keys(bin).find(\n  k => (bin[k].fileName || '').toLowerCase().endsWith('.zip')\n);\nif (!key) return [];          // not an annotation reply — ignore this mail\n\n// Sender header shape varies by trigger mode; try each.\nconst j = item.json;\nlet from = j.From ?? j.from;\nif (from && typeof from === 'object') from = from.value?.[0]?.address;\nif (!from) {\n  const headers = j.payload?.headers || [];\n  from = headers.find(h => (h.name || '').toLowerCase() === 'from')?.value || 'unknown';\n}\nfrom = String(from);\nconst angle = from.match(/<([^>]+)>/);     // \"Name <a@b.com>\" -> \"a@b.com\"\nif (angle) from = angle[1];\n\nconst slug = from.split('@')[0].replace(/[^A-Za-z0-9_-]/g, '_');\n\nreturn [{\n  json: { from, slug, filename: bin[key].fileName, saved_path: `/tmp/auv_reply_${slug}.zip` },\n  binary: { data: bin[key] },\n}];"
      },
      "id": "extract-zip-attachment",
      "name": "Extract Zip Attachment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -540,
        300
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ $json.saved_path }}",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "save-zip-to-disk",
      "name": "Save Zip to Disk",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        -320,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "/tmp/auv_round_state.json",
        "options": {
          "dataPropertyName": "state"
        }
      },
      "id": "read-round-state",
      "name": "Read Round State",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        -100,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "fromJson",
        "binaryPropertyName": "state",
        "destinationKey": "state",
        "options": {}
      },
      "id": "parse-round-state",
      "name": "Parse Round State",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        120,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Round state comes from the shared file written by the send workflow.\n// convertToFile wraps items in an array, so the state file holds [ {...} ].\nconst raw   = $json.state;\nconst state = Array.isArray(raw) ? (raw[0] ?? {}) : (raw ?? {});\nconst meta  = $('Extract Zip Attachment').first().json;\n\n// Count DISTINCT senders, so one annotator replying twice can't complete a round.\nconst senders = state.senders || [];\nconst duplicate = senders.includes(meta.from);\nif (!duplicate) {\n  senders.push(meta.from);\n  state.saved_paths = [...(state.saved_paths || []), meta.saved_path];\n}\nstate.senders  = senders;\nstate.received = senders.length;\nstate.expected = state.expected || 0;\n\n// expected === 0 means the state file was missing or unreadable. Stay put rather\n// than firing the callback on the first reply.\nconst all_done = state.expected > 0 && state.received >= state.expected;\n\nreturn [{ json: {\n  ...state, all_done, duplicate,\n  from: meta.from, filename: meta.filename, saved_path: meta.saved_path,\n} }];"
      },
      "id": "update-round-state",
      "name": "Update Round State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "operation": "toJson",
        "options": {
          "fileName": "round_state.json"
        }
      },
      "id": "state-to-file",
      "name": "State to File",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "/tmp/auv_round_state.json",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "write-round-state",
      "name": "Write Round State",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-001",
              "leftValue": "={{ $('Update Round State').first().json.all_done }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "all-received",
      "name": "All Received?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $('Update Round State').first().json.saved_path }}",
        "options": {
          "dataPropertyName": "data"
        }
      },
      "id": "read-saved-zip",
      "name": "Read Saved Zip",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1220,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Update Round State').first().json.callback_url }}",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "all_complete"
            },
            {
              "name": "round_id",
              "value": "={{ $('Update Round State').first().json.round_id }}"
            },
            {
              "name": "received",
              "value": "={{ $('Update Round State').first().json.received }}"
            },
            {
              "name": "expected",
              "value": "={{ $('Update Round State').first().json.expected }}"
            },
            {
              "name": "saved_paths",
              "value": "={{ JSON.stringify($('Update Round State').first().json.saved_paths) }}"
            },
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": {}
      },
      "id": "notify-pipeline",
      "name": "Notify Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1440,
        200
      ]
    },
    {
      "parameters": {},
      "id": "partial---log-only",
      "name": "Partial - Log Only",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1220,
        400
      ]
    }
  ],
  "connections": {
    "Gmail Trigger": {
