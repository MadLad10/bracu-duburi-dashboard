# Copy to .streamlit/secrets.toml (git-ignored) and fill in.
# On Streamlit Community Cloud, paste these into App settings → Secrets instead.

# Admin password login. Required — admin login is disabled when unset.
ADMIN_PASSWORD = "choose-a-strong-password"

# Optional: Google OAuth admin login. Only ADMIN_EMAIL may sign in.
# Leave unset to show password login only.
GOOGLE_CLIENT_ID     = ""
GOOGLE_CLIENT_SECRET = ""
REDIRECT_URI         = "https://your-app.streamlit.app"
ADMIN_EMAIL          = "you@example.com"

# Optional: public n8n URL to show live status on the Pipeline page.
N8N_URL = ""
